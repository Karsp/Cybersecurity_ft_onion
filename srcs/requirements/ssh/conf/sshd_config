# The port required by the subject
Port 4242

# Address to listen on (0.0.0.0 means all internal Docker interfaces)
ListenAddress 0.0.0.0

# Security: Disable root login and empty passwords
PermitRootLogin no
PermitEmptyPasswords no

# Authentication: Allow password login for simplicity, 
# but only for our specific user.
PasswordAuthentication yes
ChallengeResponseAuthentication no
UsePAM yes

# Logging for debugging (optional)
SyslogFacility AUTH
LogLevel INFO